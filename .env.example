# ===== LLM (llama-server, OpenAI-compatible) =====
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
# false = send enable_thinking:false to the chat template (needs llama-server --jinja)
LLM_THINKING=false
# false = never send tool definitions (use /post <caption> instead of the LLM drafting posts)
LLM_TOOLS=true
# true = show new images to the model so it can write captions (needs llama-server --mmproj; untested)
LLM_VISION=false

# ===== WhatsApp =====
WHATSAPP_ENABLED=true
BOT_NAME=pawlite
# Comma-separated phone numbers (digits only, with country code). Required, or nobody can talk to the bot.
ALLOWED_NUMBERS=
# true = use the "Message yourself" chat on the linked account
SELF_CHAT=false
# Optional: link with a pairing code instead of a QR (digits only, country code)
PAIRING_PHONE=
LOG_LEVEL=warn

# ===== Telegram =====
# Create a bot with @BotFather and paste the token. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Required. (The bot logs the ID of anyone it ignores.)
ALLOWED_TELEGRAM_IDS=
TELEGRAM_API_BASE=https://api.telegram.org

# ===== Email (IMAP/SMTP (Gmail or any compatible mailbox) & Agentmail) =====

# Comma-separated sender addresses the bot will answer with IMAP/SMTP or Agentmail. Required for either provider.
EMAIL_ALLOWED=
# How often to check for new mail (minimum 15)
EMAIL_POLL_SECONDS=120
# Gmail/IMAP only: ignore mail whose DKIM/DMARC check failed (forged senders)
EMAIL_REQUIRE_AUTH=true
# Hourly email limit, used twice: automatic replies per sender, and new emails sent in total
EMAIL_MAX_PER_HOUR=20
IMAP_ERROR_LOGGER=false
# Sending NEW email (the agent drafts with its send_email tool; you approve with /send).
# By default it can only email addresses listed in EMAIL_ALLOWED. Set true to allow any address.
EMAIL_SEND_ANY=false
# Which mailbox new mail goes out from when both are configured: imap or agentmail (default: imap)
# EMAIL_SEND_VIA=imap

# IMAP/SMTP email, e.g. youragent@gmail.com, agentemail16charpw, you@example.com
# Use a DEDICATED account with 2-Step Verification and an App Password, not your normal password.
IMAP_USER=
# This is no ordinary password if you're using Gmail. You need to request an app specific 16-digit password and enable
# 2-step verification
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Agentmail REST API, e.g. api key, youragent@agentmail.to, you@example.com
AGENTMAIL_API_KEY=
# The inbox address, e.g. mybot@agentmail.to
AGENTMAIL_INBOX_ID=
AGENTMAIL_API_BASE=https://api.agentmail.to/v0

# ===== Instagram posting (official Graph API) =====
# All three are required to enable posting.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public https URL that reaches HTTP_PORT on this machine (cloudflared / ngrok / reverse proxy)
PUBLIC_BASE_URL=
# graph.instagram.com for "Instagram API with Instagram Login" (default);
# use https://graph.facebook.com if your token comes from Facebook Login.
IG_GRAPH_HOST=https://graph.instagram.com
IG_API_VERSION=v25.0
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# ===== Behaviour =====
# optional, links memory for identities from different channel
# example: IDENTITY_LINKS=wa:447700900123@s.whatsapp.net,tg:123456789,em:you@example.com
IDENTITY_LINKS=
HISTORY_CHARS=16000
# WARNING: lets the model run shell commands. Only enable inside Docker.
ENABLE_SHELL=false

# ===== Compaction (keeps memory and history from growing forever) =====
# Sizes are ESTIMATED tokens (characters / COMPACT_CHARS_PER_TOKEN). After each reply the bot checks the chat,
# and if it is over a limit it compacts it (after sending the reply). /compact always works.
COMPACT_ENABLED=true
# Summarize old messages once a chat's un-summarized history exceeds this
COMPACT_HISTORY_TOKENS=3500
# Rewrite MEMORY.md (deduplicated; old copy kept as MEMORY.md.bak) once it exceeds this
COMPACT_MEMORY_TOKENS=1500
# The newest messages are always kept word-for-word
COMPACT_KEEP_MESSAGES=10
COMPACT_SUMMARY_WORDS=200
# ~4 for English. Lower it (2-3) for Chinese/Japanese/Korean or emoji-heavy chats.
COMPACT_CHARS_PER_TOKEN=4
# Optional backstop: also check ALL chats every N minutes. 0 = off.
COMPACT_INTERVAL_MINUTES=120
# Where memory, the database, images and the WhatsApp login are stored.
# Leave this commented out: it defaults to ./data when you run with npm, and to the mounted ./data folder in Docker.
# Setting a relative path here would point Docker at the container's temporary filesystem.
# DATA_DIR=./data
